# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://relayroom:relayroom_dev_only@127.0.0.1:5433/relayroom
# Separate database used by `npm test` when set; otherwise tests run on in-process PGlite.
# TEST_DATABASE_URL=postgres://relayroom:relayroom_dev_only@127.0.0.1:5433/relayroom_test
PORT=4000
HOST=127.0.0.1
# Origin of the web UI (CORS + cookie checks). Use the https:// origin in production.
WEB_ORIGIN=http://localhost:5173
# Set to true behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
LOG_LEVEL=info
# Who can create accounts: "open" (anyone who can reach the server) or "invite" (only with a project invite
# code). Use "invite" whenever the server is reachable from outside this machine.
SIGNUP_MODE=open
# Sign-in/sign-up attempts allowed per client IP per minute. 0 turns the limit off.
AUTH_RATE_LIMIT=20
# Serve the built web UI (npm run build:web) from the server itself, e.g. apps/web/dist.
# WEB_DIST=apps/web/dist
