{
  "name": "@relayroom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/static": "8.3.0",
    "@relayroom/protocol": "0.1.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "@relayroom/adapter": "0.1.0"
  }
}
